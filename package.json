{
  "name": "md4lp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web-first WYSIWYG Markdown service backed by git. The .md is the byte-exact source of truth.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "server": "tsx packages/server/src/bin.ts",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "tsx": "4.22.4",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
